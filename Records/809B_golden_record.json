 [1, first-1]\n    int second = -1;\n    if (first > 1) {\n        int lo = 1, hi = first - 1;\n        while (lo < hi) {\n            int mid = (lo + hi) / 2;\n            // Query (mid, mid+1), but mid+1 might equal first\n            // We need to handle this case\n            if (mid + 1 < first) {\n                if (query(mid, mid + 1)) {\n                    hi = mid;\n                } else {\n                    lo = mid + 1;\n                }\n            } else {\n                // mid + 1 == first, query (mid, first)\n                // TAK means f(mid) <= f(first) = 0, so mid is ordered\n                if (query(mid, first)) {\n                    hi = mid;\n                } else {\n                    lo = mid + 1;\n                }\n            }\n        }\n        // Check if lo is actually ordered (not first)\n        if (lo < first && query(lo, first)) {\n            second = lo;\n        }\n    }\n        // If not found in left side, search in [first+1, n]\n    if (second == -1) {\n        int lo = first + 1, hi = n;\n        while (lo < hi) {\n            int mid = (lo + hi) / 2;\n            // Query (mid, mid+1)\n            // If TAK, there's ordered dish <= mid\n            // But we know first < lo, so we need different logic\n            // Compare mid+1 with mid: if closest to mid+1 is further, then ordered dish <= mid exists (other than first)\n            // Actually we flip: query (mid+1, mid)\n            // TAK means f(mid+1) <= f(mid), meaning ordered dish > mid exists (including mid+1 side)\n            if (query(mid + 1, mid)) {\n                lo = mid + 1;\n            } else {\n                hi = mid;\n            }\n        }\n        second = lo;\n    }\n        cout << \"2 \" << first << \" \" << second << endl;\n        return 0;\n}"}, "verified_pseudocode": "// O(log N) time (due to interactive queries), O(1) space\n\n// Helper function to send a query to Noora and receive a boolean response.\n// A query \"1 x y\" asks if dist(x) <= dist(y), where dist(p) is the minimum\n// absolute difference between `p` and any ordered dish. Returns TRUE for \"TAK\", FALSE for \"NIE\".\nFUNCTION Query(x, y):\n  PRINT \"1 \" + x + \" \" + y\n  FLUSH_OUTPUT\n  READ response_string\n  RETURN response_string == \"TAK\"\n\n// Function to find an ordered dish (or a point immediately preceding one) within a range [low, high].\n// This binary search finds the smallest index `i` in `[low, high]` such that `dist(i) <= dist(i+1)`.\n// If called with `[1, N]`, this effectively finds the leftmost ordered dish `s_1`.\nFUNCTION Find_An_Ordered_Dish(low, high):\n  WHILE low < high:\n    mid = low + (high - low) / 2\n    IF Query(mid, mid + 1): // If dist(mid) <= dist(mid+1), the target dish is at or before `mid`\n      high = mid\n    ELSE: // If dist(mid) > dist(mid+1), the target dish is after `mid`\n      low = mid + 1\n  RETURN low // `low` (which equals `high`) is the found dish/point\n\n// Main algorithm to find two ordered dishes\n1. READ N, K\n\n2. // Find the first ordered dish (first_dish).\n   // Based on the properties of `dist(x)`, this `Find_An_Ordered_Dish(1, N)` call will correctly identify `s_1` (the smallest ordered dish).\n   first_dish = Find_An_Ordered_Dish(1, N)\n\n3. // Initialize second_dish to indicate it's not found yet.\n   second_dish = -1\n\n4. // Attempt to find a second ordered dish to the left of `first_dish`.\n   IF first_dish > 1:\n     left_search_low = 1\n     left_search_high = first_dish - 1\n     WHILE left_search_low < left_search_high:\n       mid = left_search_low + (left_search_high - left_search_low) / 2\n       IF mid + 1 < first_dish: // `mid` and `mid+1` are both strictly to the left of `first_dish`\n         // Use standard `Query(mid, mid+1)` to find the smallest index `x` where `dist(x) <= dist(x+1)`.\n         IF Query(mid, mid + 1):\n           left_search_high = mid\n         ELSE:\n           left_search_low = mid + 1\n       ELSE: // `mid + 1 == first_dish`, meaning `mid` is `first_dish - 1`\n         // Directly compare `mid` with `first_dish`.\n         // Since `dist(first_dish)` is 0, `Query(mid, first_dish)` returning TRUE implies `dist(mid)` is 0.\n         IF Query(mid, first_dish):\n           left_search_high = mid // `mid` is an ordered dish, so search in `[left_search_low, mid]`\n         ELSE:\n           left_search_low = mid + 1 // `mid` is not an ordered dish, so search in `[mid+1, left_search_high]`\n\n     // After the loop, `left_search_low` (which equals `left_search_high`) is a candidate.\n     // Verify if it is indeed an ordered dish and distinct from `first_dish`.\n     IF left_search_low < first_dish AND Query(left_search_low, first_dish):\n       second_dish = left_search_low\n\n5. // If no ordered dish was found to the left of `first_dish`, search for one to its right.\n   IF second_dish == -1:\n     right_search_low = first_dish + 1\n     right_search_high = N\n     WHILE right_search_low < right_search_high:\n       mid = right_search_low + (right_search_high - right_search_low) / 2\n       // This binary search finds the smallest index `x` in `[right_search_low, right_search_high]`\n       // such that `dist(x+1) <= dist(x)`. This reliably finds the smallest ordered dish `s_j > first_dish`.\n       IF Query(mid + 1, mid):\n         right_search_low = mid + 1\n       ELSE:\n         right_search_high = mid\n\n     second_dish = right_search_low // `right_search_low` is the found dish\n\n6. // Output the two found dishes.\n   PRINT \"2 \" + first_dish + \" \" + second_dish\n   FLUSH_OUTPUT\n   TERMINATE\n", "verified_solution_code": "#include <bits/stdc++.h>\n\nusing namespace std;\n\nbool query(int x, int y) {\n  cout << \"1 \" << x << \" \" << y << endl;\n  cout.flush();\n  string response;\n  cin >> response;\n  return response == \"TAK\";\n}\n\nint find_an_ordered_dish(int low, int high) {\n  while (low < high) {\n    int mid = low + (high - low) / 2;\n    if (query(mid, mid + 1)) {\n      high = mid;\n    } else {\n      low = mid + 1;\n    }\n  }\n  return low;\n}\n\nint main() {\n  ios_base::sync_with_stdio(false);\n  cin.tie(NULL);\n\n  int n, k;\n  cin >> n >> k;\n\n  int first_dish = find_an_ordered_dish(1, n);\n  int second_dish = -1;\n\n  if (first_dish > 1) {\n    int left_search_low = 1;\n    int left_search_high = first_dish - 1;\n    while (left_search_low < left_search_high) {\n      int mid = left_search_low + (left_search_high - left_search_low) / 2;\n      if (mid + 1 < first_dish) {\n        if (query(mid, mid + 1)) {\n          left_search_high = mid;\n        } else {\n          left_search_low = mid + 1;\n        }\n      } else {\n        if (query(mid, first_dish)) {\n          left_search_high = mid;\n        } else {\n          left_search_low = mid + 1;\n        }\n      }\n    }\n    if (left_search_low < first_dish && query(left_search_low, first_dish)) {\n      second_dish = left_search_low;\n    }\n  }\n\n  if (second_dish == -1) {\n    int right_search_low = first_dish + 1;\n    int right_search_high = n;\n    while (right_search_low < right_search_high) {\n      int mid = right_search_low + (right_search_high - right_search_low) / 2;\n      if (query(mid + 1, mid)) {\n        right_search_low = mid + 1;\n      } else {\n        right_search_high = mid;\n      }\n    }\n    second_dish = right_search_low;\n  }\n\n  cout << \"2 \" << first_dish << \" \" << second_dish << endl;\n  cout.flush();\n\n  return 0;\n}", "fuzzer_script": "import random\n\n# Constraints\nMIN_N = 2\nMAX_N = 10**5\nMIN_K = 2\n\n# Probabilities for edge cases\n# Probability to pick min/max N instead of random N\nN_EDGE_PROB = 0.2\n# Probability to pick min/max K (relative to N) instead of random K\nK_EDGE_PROB = 0.3\n\n# Generate n\nif random.random() < N_EDGE_PROB:\n    if random.random() < 0.5: # Small N\n        n = random.randint(MIN_N, min(10, MAX_N)) # e.g., N in [2, 10]\n    else: # Max N\n        n = MAX_N\nelse: # Random N within full range\n    n = random.randint(MIN_N, MAX_N)\n\n# Generate k\n# k must be at least MIN_K and at most n\nmin_k_for_n = MIN_K\nmax_k_for_n = n\n\nif random.random() < K_EDGE_PROB:\n    if random.random() < 0.5: # Min K (i.e., 2)\n        k = min_k_for_n\n    else: # Max K (i.e., k=n)\n        k = max_k_for_n\nelse: # Random K within [MIN_K, n]\n    k = random.randint(min_k_for_n, max_k_for_n)\n\n# Generate k distinct dishes in ascending order\n# random.sample picks k unique elements from the population (1 to n inclusive)\n# range(1, n + 1) generates numbers from 1 up to n\nordered_dishes = sorted(random.sample(range(1, n + 1), k))\n\n# Print n and k on the first line\nprint(n, k)\n\n# Print the ordered dishes on the second line, space-separated\nprint(*ordered_dishes)\n", "fuzz_test_cases": [], "code_quality_analysis": {"best_oracle_id": "oracle_0", "oracle_ratings": {"oracle_0": {"rating": "Excellent", "justification": "The solution correctly implements an interactive binary search strategy to find two distinct ordered dishes within the given query limit. It leverages the property of the `dist(p)` function (minimum distance from `p` to any ordered dish) to narrow down search ranges. The initial `Find_An_Ordered_Dish` function (used for `first_dish`) finds an ordered dish by searching for the leftmost point `x` where `dist(x) <= dist(x+1)`. The subsequent searches for `second_dish` (both left and right branches) intelligently adapt this binary search logic. The combined approach results in `O(log N)` queries (approximately `2 * log2(10^5) = 34` queries for `N=10^5`), which is well within the 60-query limit. The code is clean, efficient, and handles various edge cases correctly, such as `k=2`, `first_dish` being `1` or `N`, and correctly finding either a predecessor or a successor dish."}}}}
